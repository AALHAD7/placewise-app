# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# aistudio.google.com/apikey — free tier, no credit card required.
# Used for both generation (cascades across gemini-3.5-flash-lite / 3.1-flash-lite /
# 2.5-flash-lite / 3.5-flash / 3.6-flash / 3.7-flash as each model's daily quota
# is exhausted, see src/lib/gemini.js) and embeddings (gemini-embedding-001).
GEMINI_API_KEY=your_gemini_api_key

# gnews.io/register — free tier, 100 requests/day, no credit card required.
# Used for company and industry/domain news (cached in Supabase, see backend/db/migration_003_news_cache.sql).
GNEWS_API_KEY=your_gnews_api_key

PORT=4000

# development | production. Controls: error response detail (hidden in
# production), the dev-only /api/dev/test-login bypass (404s in production),
# and the HTTPS-required check in server.js.
NODE_ENV=development

# Second, independent gate on /api/dev/test-login (see routes/dev.js) — must
# be exactly "true" for the route to respond, in addition to NODE_ENV not
# being "production". Leave unset/false everywhere except your own local
# dev machine. Delete this var and the route entirely once real login ships.
ENABLE_DEV_LOGIN=true

# Comma-separated list of browser origins allowed to call this API in
# production, e.g. https://your-frontend.vercel.app,https://www.your-domain.com
# Required once NODE_ENV=production — CORS fails closed (no origin allowed)
# without it, rather than falling back to "allow everything".
FRONTEND_ORIGIN=

# Comma-separated list of Google account emails allowed into /admin and
# /api/admin/* (see middleware/admin.js). Checked server-side against the
# REAL authenticated Supabase user's email on every request — never a
# client-side flag. Leave unset/empty to disable admin access entirely.
ADMIN_EMAILS=

# Retired 2026-11-12 (see log.md): live-measured Nemotron latency (3.3-13.3s)
# almost always exceeded the 4s cascade timeout, so 30 of 31 real chat.js
# calls fell back to Gemini anyway - pure added latency, zero benefit.
# Replaced by the Groq cascade below. Leave both unset/false in production.
NVIDIA_NEMOTRON3_ULTRA_BASE_URL=
NVIDIA_NEMOTRON3_ULTRA_API_KEY=
ENABLE_NVIDIA_CASCADE=

# console.groq.com/keys — free tier. Used by src/lib/gemini.js's
# generateChatText/generateChatJSON (chat.js's ungrounded passthrough,
# mockInterview.js's opening-question generation) and src/lib/promptGuard.js
# (prompt-injection screening). Never the grounded/RAG paths or mock
# interview's answer-scoring call - see comments in gemini.js/mockInterview.js.
GROQ_API_KEY=

# Off by default. "true" makes generateChatText/generateChatJSON try Groq's
# openai/gpt-oss-120b first, 5s timeout, falling straight through to the
# existing Gemini cascade on any non-2xx/timeout/error/empty response/failed
# shape-validation. Live-measured 2026-11-12: 0.8-1.1s even on a ~10.7k-char
# prompt, comfortably inside the timeout (unlike the retired NVIDIA cascade
# above). Unset/false = Gemini only, today's exact behavior if this were off.
ENABLE_GROQ_CASCADE=

# Off by default. "true" screens free-form user text (qa.js's /ask, chat.js)
# through Groq's llama-prompt-guard-2-86m classifier before it reaches
# Gemini, rejecting anything scoring >=0.9 on prompt-injection likelihood.
# Fails open on any error/timeout - see src/lib/promptGuard.js. Needs
# GROQ_API_KEY above.
ENABLE_PROMPT_GUARD=

# R7: off by default. "true" switches Frameworks (Consulting domain only) to
# ground against the new ingest_chunks pipeline (src/lib/consultingRetrieval.js)
# instead of document_chunks - real page-level citations, but only returns
# results once R9 has flipped some ingest_chunks rows' is_active to true.
# Unset/false = today's exact behavior. Requires migration_042 applied first.
ENABLE_CONSULTING_RAG_V2=

# D1: off by default, separate from ENABLE_CONSULTING_RAG_V2 on purpose. Prodman Frameworks
# already has live v1 (document_chunks) grounding - this flag must stay off until a real,
# deliberate PM switch-over (this flag + ingest_chunks.is_active for the PM document, together,
# logged), or the v1 cache would get silently nulled out. See frameworksGrounding.js.
ENABLE_PM_RAG_V2=

# R7b: off by default. "true" turns on the paraphrase layer for grounded Q&A and
# Frameworks (consultingRetrieval.js's groundedConsultingLookup, called with
# paraphrase: true from qaRetrieval.js and frameworksGrounding.js's findGroundingV2
# only) - a casebook excerpt is rewritten in clearer language by Gemini, then checked
# by a faithfulness judge; a rejected or errored paraphrase falls back to the raw
# excerpt. Does not affect Guesstimates, Role/Skill pages or Company pages - those
# callers don't opt in to the paraphrase param, so they are untouched by this flag
# either way. Unset/false = today's exact verbatim-excerpt behavior. See the
# grounded-answering skill's "paraphrase layer" section.
ENABLE_ANSWER_PARAPHRASE=
