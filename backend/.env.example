# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# aistudio.google.com/apikey — free tier, no credit card required.
# Used for both generation (cascades across gemini-3.5-flash-lite / 3.1-flash-lite /
# 2.5-flash-lite / 3.5-flash / 3.6-flash / 3.7-flash as each model's daily quota
# is exhausted, see src/lib/gemini.js) and embeddings (gemini-embedding-001).
GEMINI_API_KEY=your_gemini_api_key

# gnews.io/register — free tier, 100 requests/day, no credit card required.
# Used for company and industry/domain news (cached in Supabase, see backend/db/migration_003_news_cache.sql).
GNEWS_API_KEY=your_gnews_api_key

PORT=4000

# development | production. Controls: error response detail (hidden in
# production), the dev-only /api/dev/test-login bypass (404s in production),
# and the HTTPS-required check in server.js.
NODE_ENV=development

# Second, independent gate on /api/dev/test-login (see routes/dev.js) — must
# be exactly "true" for the route to respond, in addition to NODE_ENV not
# being "production". Leave unset/false everywhere except your own local
# dev machine. Delete this var and the route entirely once real login ships.
ENABLE_DEV_LOGIN=true

# Comma-separated list of browser origins allowed to call this API in
# production, e.g. https://your-frontend.vercel.app,https://www.your-domain.com
# Required once NODE_ENV=production — CORS fails closed (no origin allowed)
# without it, rather than falling back to "allow everything".
FRONTEND_ORIGIN=

# Comma-separated list of Google account emails allowed into /admin and
# /api/admin/* (see middleware/admin.js). Checked server-side against the
# REAL authenticated Supabase user's email on every request — never a
# client-side flag. Leave unset/empty to disable admin access entirely.
ADMIN_EMAILS=

# NVIDIA NIM endpoint for the Nemotron 3 Ultra model, if used as an
# additional model in the Gemini cascade (src/lib/gemini.js). Not yet wired
# up — leave unset until a feature calls for it.
NVIDIA_NEMOTRON3_ULTRA_BASE_URL=
NVIDIA_NEMOTRON3_ULTRA_API_KEY=

# R7: off by default. "true" switches Frameworks (Consulting domain only) to
# ground against the new ingest_chunks pipeline (src/lib/consultingRetrieval.js)
# instead of document_chunks - real page-level citations, but only returns
# results once R9 has flipped some ingest_chunks rows' is_active to true.
# Unset/false = today's exact behavior. Requires migration_042 applied first.
ENABLE_CONSULTING_RAG_V2=
