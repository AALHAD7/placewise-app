# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# aistudio.google.com/apikey — free tier, no credit card required.
# Used for both generation (cascades across gemini-3.5-flash-lite / 3.1-flash-lite /
# 2.5-flash-lite / 3.5-flash / 3.6-flash / 3.7-flash as each model's daily quota
# is exhausted, see src/lib/gemini.js) and embeddings (gemini-embedding-001).
GEMINI_API_KEY=your_gemini_api_key

# gnews.io/register — free tier, 100 requests/day, no credit card required.
# Used for company and industry/domain news (cached in Supabase, see backend/db/migration_003_news_cache.sql).
GNEWS_API_KEY=your_gnews_api_key

PORT=4000

# development | production. Controls: error response detail (hidden in
# production), the dev-only /api/dev/test-login bypass (404s in production),
# and the HTTPS-required check in server.js.
NODE_ENV=development

# Second, independent gate on /api/dev/test-login (see routes/dev.js) — must
# be exactly "true" for the route to respond, in addition to NODE_ENV not
# being "production". Leave unset/false everywhere except your own local
# dev machine. Delete this var and the route entirely once real login ships.
ENABLE_DEV_LOGIN=true

# Comma-separated list of browser origins allowed to call this API in
# production, e.g. https://placementmasteryhub.com,https://www.placementmasteryhub.com
# Required once NODE_ENV=production — CORS fails closed (no origin allowed)
# without it, rather than falling back to "allow everything".
FRONTEND_ORIGIN=
