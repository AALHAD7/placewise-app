# Backend API base URL. Local dev default matches backend/.env's PORT=4000.
# In production (Vercel), set this to the deployed backend's URL, e.g.
# https://<service-name>.onrender.com
VITE_API_BASE=http://localhost:4000

# Supabase → Project Settings → API. Same project as backend/.env's
# SUPABASE_URL. This is the "anon" / "public" key, NOT the service role key -
# it's designed to be embedded in frontend code and is safe to expose (Row
# Level Security / the backend's own auth checks are what actually protect
# data, not keeping this key secret).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
