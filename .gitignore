# Dependencies and build output
node_modules/
dist/
dist-ssr/

# Secrets - only the .env.example templates are committed
.env
.env.*
!.env.example

# Codex CLI config - contains plaintext API tokens (Render, Supabase), never committed
.codex/

# Source casebooks (large, third-party). Already ingested into Supabase,
# not needed to build or run either app.
Data/

# Third-party reference libraries kept alongside the frontend for design
# reference only - not imported by the app (see frontend-react/vite.config.ts)
frontend-react/Components/
frontend-react/Icons/
frontend-react/Transitions/

# Local tooling state
.gstack/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/launch.json
.vscode/
.DS_Store
*.log
.Rhistory

# Ingestion: local venv, caches and outputs containing casebook text/page images
backend/ingestion/venv/
backend/ingestion/**/__pycache__/
backend/ingestion/*_output.json
backend/ingestion/old_chunks_*.json
backend/ingestion/out/
backend/ingestion/review/

# scripts/backups/ is scratch output for one-off content scripts (e.g.
# simplifyFrameworkJargon.js) - the backup/diff that matters for a given run is
# copied into a reviewable repo folder (e.g. content/<run>/) instead of living here.
backend/scripts/backups/
